# --- Database (Neon) ---------------------------------------------------------
# From the Neon console: your project -> Connect. Copy both strings.

# App: the POOLED connection (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Migrations / Prisma Studio: the DIRECT connection. Remove ONLY "-pooler" from
# the host and keep everything else (e.g. ".c-4"), or login fails with
# "password authentication failed" even though the password is right.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Tests: a SEPARATE database whose name ends in _test (tests wipe every table).
# Create it in Neon (Databases -> New database -> "dinkup_test"), then use its
# DIRECT connection string here.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.c-4.ap-southeast-1.aws.neon.tech/dinkup_test?sslmode=require

# --- App --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development
# Rolling week of labeled demo games + "Try the demo" button. Set false to turn off.
DEMO_MODE=true
