# --- Database ---------------------------------------------------------------
# Local Docker (default):
DATABASE_URL=postgresql://dinkup:dinkup@localhost:5432/dinkup

# Neon: use the POOLED string (host contains "-pooler") for the app, and the
# DIRECT string for migrations. Both come from Neon's "Connect" dialog.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Tests always run against local Docker; the name must end in _test.
TEST_DATABASE_URL=postgresql://dinkup:dinkup@localhost:5432/dinkup_test

# --- App --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development
