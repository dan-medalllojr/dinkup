generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Stored as "3.0" … "5.0" in the database; ordered lowest → highest.
enum SkillLevel {
  L3_0 @map("3.0")
  L3_5 @map("3.5")
  L4_0 @map("4.0")
  L4_5 @map("4.5")
  L5_0 @map("5.0")

  @@map("skill_level")
}

enum PreferredFormat {
  singles
  doubles
  either

  @@map("preferred_format")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(60)
  email           String          @unique @db.VarChar(254)
  passwordHash    String          @map("password_hash")
  photoUrl        String?         @map("photo_url")
  skillLevel      SkillLevel      @default(L3_0) @map("skill_level")
  preferredFormat PreferredFormat @default(either) @map("preferred_format")
  skillPoints     Int             @default(0) @map("skill_points")
  isDemo          Boolean         @default(false) @map("is_demo")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  hostedGames Game[]              @relation("HostedGames")
  gamesJoined GamePlayer[]
  comments    GameComment[]
  courtsAdded Court[]             @relation("AddedCourts")
  reported    MatchResult[]       @relation("ReportedResults")
  confirmed   MatchResult[]       @relation("ConfirmedResults")
  results     MatchResultPlayer[]

  @@map("users")
}

// Owned by connect-pg-simple. Defined here so Prisma migrations create it
// and `migrate dev` doesn't flag it as drift.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum CourtSetting {
  indoor
  outdoor
  covered

  @@map("court_setting")
}

model Court {
  id         String        @id @default(uuid()) @db.Uuid
  // Stable key so the seed can upsert without creating duplicates.
  slug       String        @unique @db.VarChar(80)
  name       String        @db.VarChar(100)
  address    String        @db.VarChar(200)
  city       String        @db.VarChar(60)
  lat        Float
  lng        Float
  courtCount Int?          @map("court_count")
  setting    CourtSetting?
  notes      String?       @db.VarChar(300)
  // Where the pin came from, so bad data can be traced and fixed.
  source     String        @db.VarChar(200)
  // Set when a player added this court from the app; null for curated courts.
  addedById  String?       @map("added_by_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // SetNull: if the player deletes their account, the court stays.
  addedBy User?  @relation("AddedCourts", fields: [addedById], references: [id], onDelete: SetNull)
  games   Game[]

  @@index([addedById])
  @@map("courts")
}

enum GameFormat {
  singles
  doubles

  @@map("game_format")
}

// "full" is not a status: it's derived from player count vs capacity so it
// can never drift out of sync.
enum GameStatus {
  open
  cancelled
  completed

  @@map("game_status")
}

model Game {
  id            String      @id @default(uuid()) @db.Uuid
  hostId        String      @map("host_id") @db.Uuid
  courtId       String      @map("court_id") @db.Uuid
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(6)
  durationMin   Int         @map("duration_min")
  // Total players including the host: 2 for singles, 4 for doubles.
  capacity      Int
  format        GameFormat
  minSkillLevel SkillLevel? @map("min_skill_level")
  status        GameStatus  @default(open)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  host     User          @relation("HostedGames", fields: [hostId], references: [id], onDelete: Cascade)
  // Restrict: a court with games can't be deleted out from under them.
  court    Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)
  players  GamePlayer[]
  comments GameComment[]
  result   MatchResult?

  @@index([startsAt])
  @@index([hostId])
  @@map("games")
}

model GamePlayer {
  gameId   String   @map("game_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite key: a player can't join the same game twice.
  @@id([gameId, userId])
  @@index([userId])
  @@map("game_players")
}

model GameComment {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@map("game_comments")
}

enum ResultStatus {
  pending
  confirmed
  disputed
  expired

  @@map("result_status")
}

enum ResultSide {
  winner
  loser

  @@map("result_side")
}

// One result per game (unique game_id). Points are only ever awarded when a
// player on the losing side confirms; see routes/results.ts for every guard.
model MatchResult {
  id            String       @id @default(uuid()) @db.Uuid
  gameId        String       @unique @map("game_id") @db.Uuid
  reportedById  String       @map("reported_by_id") @db.Uuid
  // e.g. "11-7, 9-11, 11-5", winners' points first.
  score         String       @db.VarChar(60)
  status        ResultStatus @default(pending)
  confirmedById String?      @map("confirmed_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  // When it was confirmed, disputed, or expired.
  resolvedAt    DateTime?    @map("resolved_at") @db.Timestamptz(6)

  game        Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reportedBy  User                @relation("ReportedResults", fields: [reportedById], references: [id], onDelete: Cascade)
  confirmedBy User?               @relation("ConfirmedResults", fields: [confirmedById], references: [id], onDelete: SetNull)
  players     MatchResultPlayer[]

  // Lazy expiry scans pending results by age.
  @@index([status, createdAt])
  @@map("match_results")
}

model MatchResultPlayer {
  resultId    String      @map("result_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  side        ResultSide
  // Winners only, set on confirmation: 0 or 1, and why.
  points      Int         @default(0)
  pointsNote  String?     @map("points_note") @db.VarChar(40)
  leveledUpTo SkillLevel? @map("leveled_up_to")

  result MatchResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([resultId, userId])
  // "Wins against this opponent in the last 30 days" joins through here.
  @@index([userId, side])
  @@map("match_result_players")
}
